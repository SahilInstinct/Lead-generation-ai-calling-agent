# --- Application Settings ---
APP_NAME=ApkaPG AI Outbound Calling System
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO

# --- Backend API Security ---
# Required in X-API-Key header when calling /api/calls/initiate and sync endpoints
API_AUTH_KEY=change-me-to-a-strong-random-key

# --- Local Storage ---
DATA_DIR=data

# --- Testing / Provider Mode ---
# Keep true during local development/mocked testing
MOCK_PROVIDERS=true

# --- Dograh AI Configuration ---
# Running locally on port 8000
DOGRAH_API_BASE_URL=http://127.0.0.1:8000
# Create under Dograh UI -> Developers -> API Keys (starts with dgr_)
DOGRAH_API_KEY=
# Stable workflow_uuid of your published ApkaPG Voice Agent (set in Phase 4 if not created yet)
DOGRAH_WORKFLOW_UUID=
# Optional numeric workflow ID from Dograh URL (e.g. /workflow/12 -> 12)
DOGRAH_WORKFLOW_ID=
# Set true to call the draft test endpoint instead of published workflow
DOGRAH_USE_DRAFT_TEST=false
# Optional integer if multiple telephony configs exist in Dograh
DOGRAH_TELEPHONY_CONFIG_ID=
# Shared secret configured on Dograh's Webhook node (Authorization: Bearer <secret>)
DOGRAH_WEBHOOK_SECRET=

# --- Vobiz Configuration (Managed inside Dograh Telephony) ---
VOBIZ_MODE=dograh_managed
VOBIZ_AUTH_ID=
VOBIZ_CALLER_ID=
VOBIZ_WEBHOOK_SECRET=

# --- LLM & TTS Reference (Configured inside Dograh AI) ---
GROQ_API_KEY=
SARVAM_API_KEY=